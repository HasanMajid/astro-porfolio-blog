---
import ThemeController from '../components/ThemeController'
import { ViewTransitions } from 'astro:transitions'
const base = Astro.url.pathname.split('/')[1]
---

<nav
    class="navbar z-10 bg-base-100 shadow-lg drop-shadow-lg text-base-content rounded-box glass sticky top-2 left-2 bg-transparent"
>
    <div class="flex flex-col">
        <h1 class="btn btn-ghost text-4xl">
            <a href="/" class="">Hasan Majid</a>
        </h1>
        <p class="">Simplicty above all</p>
    </div>
    <div class="flex gap-10 w-fit ml-auto items-center justify-center">
        <div class="h-14">
            <ThemeController client:only="solid" />
        </div>
        <div
            role="tablist"
            class="flex flex-row gap-4 tabs tabs-boxed shadow-lg"
        >
            <a
                href="/"
                role="tab"
                class:list={[
                    'btn btn-ghost text-2xl tab',
                    base === '' && 'tab-active',
                ]}
            >
                Home
            </a>
            <a
                href="/blog"
                role="tab"
                class:list={[
                    'btn btn-ghost text-2xl tab',
                    base === 'blog' && 'tab-active',
                ]}
            >
                Blog
            </a>
        </div>
        <!-- <ul class="flex flex-row">
            <li>
                <a class="btn btn-link drawer-button" href="/blog/post-1/"
                    >Post 1</a
                >
            </li>

            <li>
                <a class="btn btn-link drawer-button" href="/blog/post-2/"
                    >Post 2</a
                >
            </li>
            <li>
                <a class="btn btn-link drawer-button" href="/blog/post-3/"
                    >Post 3</a
                >
            </li>
        </ul> -->
    </div>
</nav>
<div class="divider"></div>
<ViewTransitions />

<script>
    document.addEventListener('astro:page-load', () => {
        const theme = window.localStorage.getItem('data-theme')
        if (theme === null) {
            document.documentElement.setAttribute('data-theme', 'light')
            window.localStorage.setItem('data-theme', 'light')
        } else {
            document.documentElement.setAttribute('data-theme', theme)
        }
    })
</script>
