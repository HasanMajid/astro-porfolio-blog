---
const { title, description, url, image } = Astro.props
---

<li>
    <a
        href={url}
        class="flex flex-col justify-center items-center gap-2 p-3 border-2 w-[25rem] h-[20rem] rounded-box shadow-md"
    >
        <img
            src={image.url}
            alt={image.alt}
            class="w-[25rem] h-[13rem] rounded-lg"
        />
        <h2 class="text-xl font-bold">{title}</h2>
        <div class="flex flex-col gap-1">
            <p class="text-sm self-center">{description}</p>
        </div>
    </a>
</li>
