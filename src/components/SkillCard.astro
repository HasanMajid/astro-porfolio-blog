---
import { Image } from 'astro:assets'
const { img, styles = '' } = Astro.props
---

<div class="glass rounded-full card card-bordered bg-base-100 shadow-lg">
    <div class:list={['rounded-full hover:shadow-2xl p-5', styles]}>
        <Image src={img} width={100} height={100} alt={img} class="w-28" />
    </div>
</div>
