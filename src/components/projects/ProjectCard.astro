---
interface Props {
    title: string
    description: string
    github_url: string
    website_url: string
    image_url: string
}
const { title, description, github_url, website_url, image_url } = Astro.props
---

<div
    class="flex flex-col rounded-box shadow-lg border-2 border-gray-200 p-4 my-4 w-[32rem]"
>
    <div class="flex flex-row gap-3 ml-auto">
        <a href={website_url} target="_blank" class="text-blue-500">
            Website
        </a>
        <a href={github_url} target="_blank" class="text-blue-500"> Github </a>
    </div>
    <a href={website_url} target="_blank" class="text-blue-500">
        <img src={image_url} alt={title} class="w-[30rem] h-[20rem] border-2" />
    </a>
    <h3 class="text-2xl font-bold text-center">{title}</h3>
    <p class="text-gray-500 text-center text-wrap">{description}</p>
</div>
